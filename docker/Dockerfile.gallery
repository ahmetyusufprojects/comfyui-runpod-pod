FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl ffmpeg git gnupg libgomp1 python3 python3-venv tini \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/webui-venv \
    && /opt/webui-venv/bin/pip install --no-cache-dir Pillow==12.2.0 huggingface-hub==0.36.2 uv==0.13.7 psutil==7.0.0

ENV WEBUI_RUNPOD=1 WEBUI_SETUP_PASSWORDLESS=1 PYTHONUNBUFFERED=1 \
    POD_RUNTIME_ROOT=/opt/runtime POD_VOLUME_MOUNT=/workspace POD_MODEL_STORAGE=/models \
    POD_ALLOW_EPHEMERAL_DATA=1 \
    POD_MODEL_CATALOG=/opt/pod/models.json \
    WEBUI_DATA_ROOT=/opt/runtime/user-data \
    GPG_HOME=/opt/runtime/gnupg GPG_PATH=/usr/bin/gpg \
    HF_HOME=/opt/runtime/hf-cache XDG_CACHE_HOME=/opt/runtime/cache \
    UV_BIN=/opt/webui-venv/bin/uv UV_CACHE_DIR=/opt/runtime/uv-cache \
    COMFYUI_ROOT=/opt/runtime/ComfyUI COMFYUI_URL=127.0.0.1:8188 \
    LLAMA_SERVER_PATH=/opt/runtime/bin/llama-server \
    NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility

COPY webui_flux2/arsiv.py webui_flux2/auth.py webui_flux2/comfy_client.py webui_flux2/flex_store.py webui_flux2/image_graphs.py webui_flux2/image_utils.py webui_flux2/index.html webui_flux2/kasa.py webui_flux2/llm.py webui_flux2/pod_setup.py webui_flux2/app_update.py webui_flux2/prompt_store.py webui_flux2/prompt_translation.py webui_flux2/server.py webui_flux2/video_r2v_api.json webui_flux2/video_wan22_api.json /opt/webui_flux2/
COPY webui_flux2/static/app.css webui_flux2/static/app.js /opt/webui_flux2/static/
COPY webui_flux2/setup.html /opt/webui_flux2/
COPY webui_flux2/static/setup.css webui_flux2/static/setup.js /opt/webui_flux2/static/
COPY webui_flux2/model_prompts/ /opt/webui_flux2/model_prompts/
COPY docker/models.json /opt/pod/models.json
COPY docker/Dockerfile.gallery /opt/pod/base.Dockerfile
COPY docker/supervisor.py /opt/pod/supervisor.py
ENV WEBUI_UPDATE_SUPERVISOR=1
WORKDIR /opt/webui_flux2
EXPOSE 8189 8192
ENTRYPOINT ["/usr/bin/tini", "-s", "-g", "--", "/opt/webui-venv/bin/python", "/opt/pod/supervisor.py"]
